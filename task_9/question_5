CREATE INDEX idx_orders_status_partial ON sales.orders(status) WHERE status != 'shipped';
SELECT pg_size_pretty(pg_relation_size('sales.idx_orders_status_partial'));


Размер полного индекса - 3408 kB
Частичного - 56 kB


